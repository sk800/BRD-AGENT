# Application
ENVIRONMENT=dev
DEBUG=true

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=brd_agent

# JWT
SECRET_KEY=change-me-to-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# File uploads
UPLOAD_DIR=data/uploads
MAX_FILE_SIZE_MB=25
MAX_FILES_PER_MESSAGE=10
